NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5434/ecommerce?schema=public"

#change it
JWT_SECRET=your-super-secret-key-minimum-32-characters-long-change-this
JWT_EXPIRATION=15m

REFRESH_TOKEN_EXPIRATION=7d

#miliseconds
RESET_PASSWORD_TOKEN_EXPIRATION=30m

CORS_ORIGIN=*

#rate limit
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=3
THROTTLE_MEDIUM_TTL=10000
THROTTLE_MEDIUM_LIMIT=20
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=100
