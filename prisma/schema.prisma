// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MANAGER
  CLIENT
  DELIVERY_PERSON

  @@map("user_role")
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  role             UserRole @default(CLIENT)
  stripeCustomerId String?  @map("stripe_customer_id")
  email            String   @unique
  passwordHash     String   @map("password_hash")
  fullName         String   @map("full_name")

  resetPasswordTokenHash String?   @map("reset_password_token_hash")
  resetPasswordExpires   DateTime? @map("reset_password_expires")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  refreshTokens  RefreshToken[]
  cartItems      CartItem[]
  favorites      Favorite[]
  orders         Order[]        @relation("UserOrders")
  deliveryOrders Order[]        @relation("DeliveryPersonOrders")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products ProductCategory[]

  @@map("categories")
}

model Product {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  description     String    @db.Text
  isActive        Boolean   @default(true) @map("is_active")
  stripeProductId String?   @map("stripe_product_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  categories      ProductCategory[]
  images          ProductImage[]
  productOptions  ProductOption[]
  productVariants ProductVariant[]

  @@map("products")
}

model ProductCategory {
  id         String @id @default(uuid()) @db.Uuid
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@map("product_categories")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  isMain    Boolean  @map("is_main")
  url       String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  productVariantId String?         @db.Uuid

  @@map("product_images")
}

model ProductOption {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@map("product_options")
}

model ProductOptionValue {
  id        String   @id @default(uuid()) @db.Uuid
  optionId  String   @map("option_id") @db.Uuid
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  option   ProductOption         @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantValue[]

  @@map("product_option_values")
}

model ProductVariant {
  id                  String    @id @default(uuid()) @db.Uuid
  productId           String    @map("product_id") @db.Uuid
  sku                 String    @unique
  price               Int
  stockQuantity       Int       @map("stock_quantity")
  image               String?   @db.Text
  isActive            Boolean   @default(true) @map("is_active")
  stripePriceId       String?   @map("stripe_price_id")
  stripePaymentLinkId String?   @map("stripe_payment_link_id")
  paymentLinkUrl      String?   @map("payment_link_url")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues  ProductVariantValue[]
  productImages ProductImage[]
  cartItems     CartItem[]
  favorites     Favorite[]
  orderItems    OrderItem[]

  @@map("product_variants")
}

// ─────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  PAYMENT_LINK
  PAYMENT_INTENT

  @@map("payment_method")
}

model Order {
  id                      String      @id @default(uuid()) @db.Uuid
  userId                  String?     @map("user_id") @db.Uuid
  guestEmail              String?     @map("guest_email")
  status                  OrderStatus @default(PENDING)
  deliveryPersonId        String?     @map("delivery_person_id") @db.Uuid
  shippingAddressSnapshot Json        @map("shipping_address_snapshot")
  promoCodeId             String?     @map("promo_code_id") @db.Uuid
  promoSnapshot           Json?       @map("promo_snapshot")
  subtotal                Int
  discountAmount          Int         @default(0) @map("discount_amount")
  totalAmount             Int         @map("total_amount")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  user           User?       @relation("UserOrders", fields: [userId], references: [id])
  deliveryPerson User?       @relation("DeliveryPersonOrders", fields: [deliveryPersonId], references: [id])
  promoCode      PromoCode?  @relation(fields: [promoCodeId], references: [id])
  items          OrderItem[]
  payments       Payment[]

  @@map("orders")
}

model OrderItem {
  id                  String @id @default(uuid()) @db.Uuid
  orderId             String @map("order_id") @db.Uuid
  productVariantId    String @map("product_variant_id") @db.Uuid
  quantity            Int
  unitPriceAtPurchase Int    @map("unit_price_at_purchase")
  totalPrice          Int    @map("total_price")
  productSnapshot     Json   @map("product_snapshot")

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@map("order_items")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @map("order_id") @db.Uuid
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  stripeSessionId       String?       @map("stripe_session_id")
  stripePaymentLinkId   String?       @map("stripe_payment_link_id")
  paymentMethod         PaymentMethod @map("payment_method")
  status                PaymentStatus @default(PENDING)
  currency              String
  amount                Int
  paymentDate           DateTime?     @map("payment_date")
  createdAt             DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model ProductVariantValue {
  productVariantId     String @map("product_variant_id") @db.Uuid
  productOptionValueId String @map("product_option_value_id") @db.Uuid

  productVariant     ProductVariant     @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  productOptionValue ProductOptionValue @relation(fields: [productOptionValueId], references: [id], onDelete: Cascade)

  @@id([productVariantId, productOptionValueId])
  @@map("product_variant_values")
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([userId, productVariantId])
  @@map("cart_items")
}

enum PromoType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("promo_type")
}

model PromoCode {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  type        PromoType
  value       Int
  expiresAt   DateTime  @map("expires_at")
  usageLimit  Int       @map("usage_limit")
  usageCount  Int       @default(0) @map("usage_count")
  minPurchase Int?      @map("min_purchase")

  maxDiscountAmount Int?     @map("max_discount_amount")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  orders            Order[]

  @@map("promo_codes")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@map("favorites")
}
